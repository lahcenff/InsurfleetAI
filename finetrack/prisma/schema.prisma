// FineTrack UAE — database schema (PostgreSQL + Prisma)
//
// Conventions
// - Every business table carries `companyId` (tenant). All queries go through a
//   tenant-scoped Prisma client; Postgres RLS can be added as defense in depth.
// - Timestamps are stored as `timestamptz` (UTC). They are parsed from and
//   displayed in Asia/Dubai (UTC+4, no DST).
// - Money is `Decimal(12,2)` in AED. Never floats.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ───────────────────────────── Enums ─────────────────────────────

enum Role {
  ADMIN   // settings, users, subscription
  MANAGER // imports, matching, billing
}

enum Emirate {
  DXB // Dubai
  AUH // Abu Dhabi
  SHJ // Sharjah
  AJM // Ajman
  UAQ // Umm Al Quwain
  RAK // Ras Al Khaimah
  FUJ // Fujairah
}

enum VehicleStatus {
  ACTIVE
  IN_MAINTENANCE
  INACTIVE
  SOLD
}

enum PartyType {
  DRIVER   // employee / shift driver
  CUSTOMER // rental or leasing customer (person or company)
}

enum AssignmentKind {
  RENTAL_CONTRACT
  ALLOCATION
  SHIFT
}

enum OffenseSource {
  SALIK
  DARB
  RTA
  POLICE
  PARKING
  OTHER
}

enum OffenseCategory {
  TOLL
  FINE
  PARKING
}

enum MatchStatus {
  ASSIGNED   // exactly one responsible party found
  TO_REVIEW  // several candidates, gap in history, or near a boundary
  UNASSIGNED // unknown plate or no assignment around that time
}

enum MatchReason {
  SINGLE_MATCH
  OVERLAP       // several assignments cover the timestamp
  GAP           // between two assignments, none covers it
  NEAR_BOUNDARY // within the grace window of a start/end
  NO_ASSIGNMENT // vehicle known, no assignment near that time
  UNKNOWN_PLATE // plate does not match any vehicle
  AMBIGUOUS_PLATE // plate code missing, several vehicles possible
  MANUAL        // set or confirmed by a user
}

enum BillingStatus {
  UNBILLED
  BILLED      // on an issued statement
  PAID
  WRITTEN_OFF // absorbed by the company (not recovered)
}

enum DisputeStatus {
  TO_DISPUTE
  SUBMITTED
  ACCEPTED   // fine cancelled
  REJECTED
  WITHDRAWN
}

enum FeeType {
  FIXED   // AED per offense
  PERCENT // % of the offense amount
}

enum StatementStatus {
  DRAFT
  ISSUED
  SENT
  PAID
  VOID
}

enum ImportEntity {
  VEHICLE
  PARTY
  ASSIGNMENT
  OFFENSE
}

enum IngestChannel {
  FILE // CSV / Excel upload
  API  // future connector (Salik, RTA, telematics…)
  MANUAL
}

enum ImportStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

enum NotificationChannel {
  WHATSAPP
  EMAIL
}

enum NotificationStatus {
  QUEUED
  SENT
  SIMULATED // V1: WhatsApp is simulated
  FAILED
}

enum ConnectorProvider {
  SALIK_API
  DARB_API
  RTA_API
  TELEMATICS
}

// ───────────────────────── Tenancy & auth ─────────────────────────

model Company {
  id            String   @id @default(cuid())
  name          String
  slug          String   @unique
  trn           String?  // UAE VAT Tax Registration Number
  defaultLocale String   @default("en") // "en" | "ar"
  plan          String   @default("STARTER") // STARTER | PRO | ENTERPRISE

  // Billing settings
  feeType          FeeType @default(FIXED)
  feeValue         Decimal @default(0) @db.Decimal(12, 2)
  vatOnFeePercent  Decimal @default(5) @db.Decimal(5, 2) // UAE VAT applies to the admin fee, not to the fine
  statementPrefix  String  @default("FT")
  nextStatementSeq Int     @default(1)

  // Matching settings
  matchGraceMinutes Int @default(15)

  createdAt DateTime @default(now()) @db.Timestamptz
  updatedAt DateTime @updatedAt @db.Timestamptz

  memberships    Membership[]
  vehicles       Vehicle[]
  parties        Party[]
  assignments    Assignment[]
  offenses       Offense[]
  importMappings ImportMapping[]
  importBatches  ImportBatch[]
  statements     Statement[]
  disputes       Dispute[]
  attachments    Attachment[]
  notifications  Notification[]
  auditLogs      AuditLog[]
  connectors     Connector[]
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  name          String?
  locale        String    @default("en")
  emailVerified DateTime? @db.Timestamptz
  createdAt     DateTime  @default(now()) @db.Timestamptz

  memberships Membership[]
  sessions    Session[]
  auditLogs   AuditLog[]
}

model Membership {
  id        String   @id @default(cuid())
  userId    String
  companyId String
  role      Role     @default(MANAGER)
  createdAt DateTime @default(now()) @db.Timestamptz

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([userId, companyId])
}

// Auth.js (email magic link) tables
model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime @db.Timestamptz
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime @db.Timestamptz

  @@unique([identifier, token])
}

// ─────────────────────────── Fleet data ───────────────────────────

model Vehicle {
  id          String        @id @default(cuid())
  companyId   String
  emirate     Emirate
  plateCode   String        // "A", "AA", "12", "" when the emirate has none
  plateNumber String        // digits only, no leading zeros
  plateKey    String        // normalized "DXB-A-12345", used for matching
  make        String?
  model       String?
  year        Int?
  status      VehicleStatus @default(ACTIVE)
  externalId  String?       // id in a telematics / ERP system
  createdAt   DateTime      @default(now()) @db.Timestamptz
  updatedAt   DateTime      @updatedAt @db.Timestamptz

  company     Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  assignments Assignment[]
  offenses    Offense[]

  @@unique([companyId, plateKey])
  @@index([companyId, emirate, plateNumber]) // fallback when plate code is missing
}

// A driver or a customer: whoever can be held responsible for an offense.
model Party {
  id             String    @id @default(cuid())
  companyId      String
  type           PartyType
  fullName       String
  companyName    String?   // for B2B customers
  whatsappPhone  String?   // E.164, e.g. +971501234567
  email          String?
  licenseNumber  String?
  licenseExpiry  DateTime? @db.Date
  emiratesId     String?
  externalId     String?   // customer id in the rental/ERP system
  preferredLocale String   @default("en")
  createdAt      DateTime  @default(now()) @db.Timestamptz
  updatedAt      DateTime  @updatedAt @db.Timestamptz

  company     Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  assignments Assignment[]
  offenses    Offense[]
  statements  Statement[]
  notifications Notification[]

  @@index([companyId, type])
  @@index([companyId, licenseNumber])
}

// Who had which vehicle, from when to when. endsAt = null means "still ongoing".
// Overlaps are allowed on purpose (data errors happen); the matcher flags them.
model Assignment {
  id            String         @id @default(cuid())
  companyId     String
  vehicleId     String
  partyId       String
  kind          AssignmentKind
  startsAt      DateTime       @db.Timestamptz
  endsAt        DateTime?      @db.Timestamptz
  reference     String?        // contract / shift number
  channel       IngestChannel  @default(MANUAL)
  importBatchId String?
  createdAt     DateTime       @default(now()) @db.Timestamptz
  updatedAt     DateTime       @updatedAt @db.Timestamptz

  company     Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  vehicle     Vehicle      @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  party       Party        @relation(fields: [partyId], references: [id], onDelete: Restrict)
  importBatch ImportBatch? @relation(fields: [importBatchId], references: [id], onDelete: SetNull)
  offenses    Offense[]
  candidateOf MatchCandidate[]

  @@index([companyId, vehicleId, startsAt])
  @@index([companyId, partyId])
}

// ───────────────────── Fines & tolls (offenses) ─────────────────────

model Offense {
  id            String          @id @default(cuid())
  companyId     String
  source        OffenseSource
  category      OffenseCategory
  externalRef   String          // ticket / transaction number from the portal
  channel       IngestChannel   @default(FILE)
  importBatchId String?

  // As received
  rawPlate    String
  emirate     Emirate?
  plateCode   String?
  plateNumber String
  occurredAt  DateTime @db.Timestamptz
  location    String?
  description String?
  amount      Decimal  @db.Decimal(12, 2)
  blackPoints Int?
  dueDate     DateTime? @db.Date
  rawData     Json?    // original row, for audit/debug

  // Matching result
  vehicleId     String?
  partyId       String?
  assignmentId  String?
  matchStatus   MatchStatus  @default(UNASSIGNED)
  matchReason   MatchReason?
  matchLocked   Boolean      @default(false) // true once a user validated/corrected: re-runs skip it
  matchedAt     DateTime?    @db.Timestamptz
  matchedById   String?      // user id when manual

  billingStatus BillingStatus @default(UNBILLED)

  createdAt DateTime @default(now()) @db.Timestamptz
  updatedAt DateTime @updatedAt @db.Timestamptz

  company        Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  importBatch    ImportBatch?     @relation(fields: [importBatchId], references: [id], onDelete: SetNull)
  vehicle        Vehicle?         @relation(fields: [vehicleId], references: [id], onDelete: SetNull)
  party          Party?           @relation(fields: [partyId], references: [id], onDelete: SetNull)
  assignment     Assignment?      @relation(fields: [assignmentId], references: [id], onDelete: SetNull)
  candidates     MatchCandidate[]
  statementLines StatementLine[]
  dispute        Dispute?

  @@unique([companyId, source, externalRef]) // de-duplicates re-imports
  @@index([companyId, occurredAt])
  @@index([companyId, matchStatus])
  @@index([companyId, partyId, billingStatus])
  @@index([companyId, vehicleId])
}

// Candidates proposed when an offense is TO_REVIEW (overlap or gap).
model MatchCandidate {
  id           String @id @default(cuid())
  offenseId    String
  assignmentId String
  reason       MatchReason

  offense    Offense    @relation(fields: [offenseId], references: [id], onDelete: Cascade)
  assignment Assignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)

  @@unique([offenseId, assignmentId])
}

// ──────────────────────────── Imports ────────────────────────────

// Saved column mapping, e.g. "Salik monthly export".
model ImportMapping {
  id         String         @id @default(cuid())
  companyId  String
  name       String
  entity     ImportEntity
  source     OffenseSource? // for OFFENSE mappings
  // { "externalRef": "Transaction ID", "occurredAt": ["Trip Date","Trip Time"], "amount": "Amount (AED)", ... }
  columnMap  Json
  dateFormat String         @default("dd/MM/yyyy HH:mm:ss")
  // Constant values applied to every row, e.g. { "category": "TOLL", "emirate": "DXB" }
  defaults   Json?
  createdAt  DateTime       @default(now()) @db.Timestamptz
  updatedAt  DateTime       @updatedAt @db.Timestamptz

  company Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  batches ImportBatch[]

  @@unique([companyId, name])
}

model ImportBatch {
  id          String         @id @default(cuid())
  companyId   String
  entity      ImportEntity
  channel     IngestChannel  @default(FILE)
  source      OffenseSource?
  mappingId   String?
  connectorId String?
  fileName    String?
  fileHash    String?        // sha256, warns on re-upload of the same file
  createdById String?
  status      ImportStatus   @default(PENDING)
  totalRows   Int            @default(0)
  inserted    Int            @default(0)
  duplicates  Int            @default(0)
  failed      Int            @default(0)
  errors      Json?          // [{ row, field, message }]
  createdAt   DateTime       @default(now()) @db.Timestamptz
  finishedAt  DateTime?      @db.Timestamptz

  company     Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  mapping     ImportMapping? @relation(fields: [mappingId], references: [id], onDelete: SetNull)
  connector   Connector?     @relation(fields: [connectorId], references: [id], onDelete: SetNull)
  offenses    Offense[]
  assignments Assignment[]

  @@index([companyId, createdAt])
}

// Future API connectors write through the same ingestion pipeline as files.
model Connector {
  id         String            @id @default(cuid())
  companyId  String
  provider   ConnectorProvider
  label      String
  config     Json              // encrypted credentials + options
  enabled    Boolean           @default(false)
  lastSyncAt DateTime?         @db.Timestamptz
  lastError  String?
  createdAt  DateTime          @default(now()) @db.Timestamptz

  company Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  batches ImportBatch[]
}

// ─────────────────────────── Re-billing ───────────────────────────

model Statement {
  id          String          @id @default(cuid())
  companyId   String
  partyId     String
  number      String          // e.g. FT-2026-00042
  periodStart DateTime        @db.Date
  periodEnd   DateTime        @db.Date
  status      StatementStatus @default(DRAFT)

  // Snapshot of fee settings at issue time
  feeType         FeeType
  feeValue        Decimal @db.Decimal(12, 2)
  vatOnFeePercent Decimal @db.Decimal(5, 2)

  subtotal  Decimal @db.Decimal(12, 2) // sum of offense amounts
  feeTotal  Decimal @db.Decimal(12, 2)
  vatTotal  Decimal @db.Decimal(12, 2)
  total     Decimal @db.Decimal(12, 2)

  publicToken    String    @unique // random, used in the driver/customer link (no account needed)
  tokenExpiresAt DateTime? @db.Timestamptz
  issuedAt       DateTime? @db.Timestamptz
  paidAt         DateTime? @db.Timestamptz
  createdById    String?
  createdAt      DateTime  @default(now()) @db.Timestamptz

  company       Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  party         Party           @relation(fields: [partyId], references: [id], onDelete: Restrict)
  lines         StatementLine[]
  notifications Notification[]

  @@unique([companyId, number])
  @@index([companyId, partyId])
}

model StatementLine {
  id          String  @id @default(cuid())
  statementId String
  offenseId   String
  amount      Decimal @db.Decimal(12, 2)
  fee         Decimal @db.Decimal(12, 2)
  vat         Decimal @db.Decimal(12, 2)
  total       Decimal @db.Decimal(12, 2)

  statement Statement @relation(fields: [statementId], references: [id], onDelete: Cascade)
  offense   Offense   @relation(fields: [offenseId], references: [id], onDelete: Restrict)

  @@unique([statementId, offenseId])
  @@index([offenseId])
}

// ─────────────────────────── Disputes ───────────────────────────

model Dispute {
  id          String        @id @default(cuid())
  companyId   String
  offenseId   String        @unique
  status      DisputeStatus @default(TO_DISPUTE)
  reason      String
  notes       String?
  submittedAt DateTime?     @db.Timestamptz
  resolvedAt  DateTime?     @db.Timestamptz
  createdById String?
  createdAt   DateTime      @default(now()) @db.Timestamptz
  updatedAt   DateTime      @updatedAt @db.Timestamptz

  company     Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  offense     Offense      @relation(fields: [offenseId], references: [id], onDelete: Cascade)
  attachments Attachment[]
}

model Attachment {
  id         String   @id @default(cuid())
  companyId  String
  disputeId  String?
  fileName   String
  mimeType   String
  sizeBytes  Int
  storageKey String   // path in object storage (S3 / Supabase Storage)
  uploadedById String?
  createdAt  DateTime @default(now()) @db.Timestamptz

  company Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  dispute Dispute? @relation(fields: [disputeId], references: [id], onDelete: Cascade)
}

// ───────────────────────── Notifications ─────────────────────────

model Notification {
  id                String              @id @default(cuid())
  companyId         String
  partyId           String
  statementId       String?
  channel           NotificationChannel
  status            NotificationStatus  @default(QUEUED)
  recipient         String              // phone or email
  body              String
  providerMessageId String?
  error             String?
  fallbackOfId      String?             // email sent because this WhatsApp attempt failed
  createdAt         DateTime            @default(now()) @db.Timestamptz
  sentAt            DateTime?           @db.Timestamptz

  company   Company    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  party     Party      @relation(fields: [partyId], references: [id], onDelete: Cascade)
  statement Statement? @relation(fields: [statementId], references: [id], onDelete: SetNull)

  @@index([companyId, createdAt])
}

// ─────────────────────────── Audit log ───────────────────────────

// Append-only. Written in the same transaction as the change it describes.
model AuditLog {
  id         String   @id @default(cuid())
  companyId  String
  actorId    String?  // null = system (import, matcher)
  action     String   // "assignment.update", "offense.match.override", ...
  entityType String
  entityId   String
  before     Json?
  after      Json?
  createdAt  DateTime @default(now()) @db.Timestamptz

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  actor   User?   @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([companyId, entityType, entityId])
  @@index([companyId, createdAt])
}
