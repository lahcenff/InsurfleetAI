# PostgreSQL (Supabase, Neon, RDS…). With Supabase use the pooled URL here and
# DIRECT_URL is not needed for `prisma migrate deploy` if you run it from CI.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/finetrack"

# Public URL of the app (used in magic links and statement links)
APP_URL="http://localhost:3000"

# E-mail (magic links + statement notifications). Without SMTP_URL, e-mails are
# printed to the server console and the sign-in link is shown on the login page.
# SMTP_URL="smtps://user:password@smtp.resend.com:465"
# EMAIL_FROM="FineTrack UAE <no-reply@yourdomain.ae>"

# Dispute attachments: local ./uploads by default. On serverless hosting (Vercel)
# use Supabase Storage (create a private bucket named "attachments").
# SUPABASE_URL="https://xxxx.supabase.co"
# SUPABASE_SERVICE_ROLE_KEY="..."
# SUPABASE_BUCKET="attachments"
# UPLOAD_DIR="/var/lib/finetrack/uploads"

# Demo data reference date (defaults to now)
# SEED_END_DATE="2026-09-26T12:00:00Z"
